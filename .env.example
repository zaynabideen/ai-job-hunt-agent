# .env.example
#
# Status: PLANNED. Nothing in this repository currently reads these
# variables - there is no automation code here yet. This file exists so
# that when the n8n workflow described in docs/ARCHITECTURE.md and
# workflows/README.md is actually built, the required configuration is
# already documented.
#
# Copy this to .env and fill in real values ONLY once you are wiring up
# actual automation (n8n, a notification integration, etc). Never commit
# your real .env file - it's already covered by .gitignore.

# --- Google Sheets (PLANNED) ---
# Needed once the sheet is read/written by automation instead of by hand.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- LLM provider (PLANNED) ---
# Only needed if you automate running the prompts instead of pasting them
# into a chat interface by hand.
LLM_PROVIDER=
LLM_API_KEY=

# --- Notifications (PLANNED, none implemented yet) ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# --- n8n (PLANNED) ---
N8N_WEBHOOK_URL=
